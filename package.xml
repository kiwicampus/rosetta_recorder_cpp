<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rosetta_recorder_cpp</name>
  <version>0.1.0</version>
  <description>
    C++ port of rosetta's episode recorder: a lifecycle node that streams the
    topics named by a rosetta contract straight into a rosbag2 MCAP bag, under
    action and service control. Messages are never deserialized, so it costs a
    fraction of the rclpy original.
  </description>
  <maintainer email="carlos.alvarez@kiwibot.com">Carlos Alvarez</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>action_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>lifecycle_msgs</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>rosetta_interfaces</depend>
  <depend>libyaml-cpp-dev</depend>

  <exec_depend>rosbag2_storage_mcap</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
